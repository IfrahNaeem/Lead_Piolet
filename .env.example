# ============================================================
# AlgoQuest — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── Supabase (Database + Auth) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Backend API ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Judge0 (Code Execution Engine) ──────────────────────────
# Free tier at judge0.com or self-host
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key-for-judge0
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# ── Redis (Caching & Rate Limiting) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── Google OAuth (Optional) ─────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── ML Model Paths ───────────────────────────────────────────
ML_MODELS_DIR=./backend/app/ml/saved_models
RECOMMENDER_MODEL_PATH=./backend/app/ml/saved_models/recommender.pkl
SCORER_MODEL_PATH=./backend/app/ml/saved_models/scorer.pkl
LEVEL_DETECTOR_PATH=./backend/app/ml/saved_models/level_detector.pkl

# ── App Config ───────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
DEBUG=true

# ── Vercel (set via Vercel dashboard, not here) ──────────────
# VERCEL_URL is auto-set by Vercel
# These are set in Vercel project settings > Environment Variables:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_API_URL  (your Railway backend URL)
